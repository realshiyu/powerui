<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerUI" Width="368" Height="300" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="Transparent" Topmost="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#202624"/>
        <SolidColorBrush x:Key="Muted" Color="#65716C"/>
        <SolidColorBrush x:Key="Track" Color="#19808080"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#18808080"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#28808080"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#30808080"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Height="28">
                    <ContentPresenter VerticalAlignment="Center" Margin="0,0,50,0"/>
                    <Border x:Name="ToggleTrack" Width="36" Height="20" CornerRadius="10" HorizontalAlignment="Right" Background="{DynamicResource Track}" BorderBrush="{DynamicResource Muted}" BorderThickness="1">
                        <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource Ink}" HorizontalAlignment="Left" Margin="3,0"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ToggleTrack" Property="Background" Value="#159F7C"/>
                        <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#159F7C"/>
                        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                        <Setter TargetName="Knob" Property="Fill" Value="White"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleTrack" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SliderTrack" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/><Setter Property="Height" Value="3"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
                <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Height="24">
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SliderTrack}" Background="#159F7C"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Ink}" BorderBrush="#159F7C" BorderThickness="2" CornerRadius="7"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SliderTrack}" Background="{DynamicResource Track}"/></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Surface" CornerRadius="8" BorderBrush="#30808080" BorderThickness="1" Padding="20,14,20,18">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid Margin="0,0,0,22">
                    <TextBlock x:Name="AppTitle" Text="PowerUI" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="Refresh" Content="&#xE72C;" ToolTip="刷新电量" AutomationProperties.Name="刷新电量"/>
                        <Button x:Name="Settings" Content="&#xE713;" ToolTip="设置" AutomationProperties.Name="设置"/>
                        <Button x:Name="Dismiss" Content="&#xE8BB;" ToolTip="收起" AutomationProperties.Name="收起"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DeviceGlyph" Text="&#xE962;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="29" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="DeviceName" Text="雷柏鼠标" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="Connection" Text="无线连接" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="Battery" Text="--" FontSize="48" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Percent" Text="%" FontSize="20" Foreground="{DynamicResource Muted}" Margin="5,0,0,9" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="Charging" Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#159F7C" FontSize="25" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="充电中"/>
                </Grid>
                <Grid Height="6" Margin="0,10,0,14">
                    <Border Background="{DynamicResource Track}" CornerRadius="3"/>
                    <Grid x:Name="BatteryTrack"><Border x:Name="BatteryFill" HorizontalAlignment="Left" Background="#159F7C" CornerRadius="3" Width="0"/></Grid>
                </Grid>
                <TextBlock x:Name="Status" Text="等待电量" FontWeight="SemiBold"/>
                <TextBlock x:Name="Updated" Text="尚未取得读数" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="0,20,0,0">
                    <Border Height="1" Background="{DynamicResource Track}" Margin="0,0,0,10"/>
                    <TextBlock Text="托盘显示" Margin="0,4,0,4"/>
                    <WrapPanel Margin="0,0,0,8">
                        <RadioButton x:Name="TraySeparate" Tag="Separate" GroupName="TrayDisplay" Content="分别显示" Foreground="{DynamicResource Ink}" Margin="0,4,14,4"/>
                        <RadioButton x:Name="TrayMouse" Tag="Mouse" GroupName="TrayDisplay" Content="仅鼠标" Foreground="{DynamicResource Ink}" Margin="0,4,14,4"/>
                        <RadioButton x:Name="TrayKeyboard" Tag="Keyboard" GroupName="TrayDisplay" Content="仅键盘" Foreground="{DynamicResource Ink}" Margin="0,4,0,4"/>
                    </WrapPanel>
                    <CheckBox x:Name="Alerts" Content="低电量提醒"/>
                    <Grid Margin="0,4,0,6"><TextBlock Text="提醒阈值"/><TextBlock x:Name="ThresholdText" HorizontalAlignment="Right"/></Grid>
                    <Slider x:Name="Threshold" Minimum="5" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" Height="24" AutomationProperties.Name="低电量提醒阈值"/>
                    <CheckBox x:Name="Startup" Content="开机启动"/>
                    <TextBlock x:Name="SaveStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <Button x:Name="Exit" Content="退出 PowerUI" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" Width="140" Height="32" HorizontalAlignment="Left" Margin="0,10,0,0" Background="{DynamicResource Track}" ToolTip="退出并停止后台刷新"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
